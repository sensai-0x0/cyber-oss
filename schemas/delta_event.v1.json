{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metacogna/sentinel-hunter/contracts/delta_event.v1.json",
  "title": "Sentinel Hunter DeltaEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "source",
    "target",
    "observed_at",
    "fingerprint",
    "attributes"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["novel", "mutated"] },
    "source": { "enum": ["tlsx", "httpx", "ct"] },
    "target": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "observed_at": { "type": "string", "format": "date-time" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attributes": { "type": "object" }
  }
}
