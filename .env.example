GITHUB_TOKEN=
# Graphiti + Sentinel-Lite Environment Configuration
# Copy this file to .env: cp .env.example .env

# --- Telemetry & Safety ---
GRAPHITI_TELEMETRY_ENABLED=false

# --- Graph Database Backend (Default: FalkorDB) ---
DATABASE_PROVIDER=falkordb
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_DATABASE=sentinel_lite
FALKORDB_THREAD_COUNT=2
FALKORDB_TIMEOUT_MS=5000

# --- Graphiti Concurrency & Reliability ---
GRAPHITI_MAX_COROUTINES=4
GRAPHITI_RETRY_ATTEMPTS=3


# --- Optional Neo4j Backend (only if DATABASE_PROVIDER=neo4j) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password

# --- LLM Provider (Entity & Relationship Extraction) ---
LLM_PROVIDER=claude
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Embedder Provider (Semantic Search) ---
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# --- Graphiti MCP Server Binding (Security: loopback only) ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=http
GRAPHITI_GROUP_ID=sentinel_lite_main

# --- Sentinel-Lite Go Core Wiring ---
HUNTER_BIN_PATH=./bin/hunter
MISSION_CONFIG=./mission.yaml
